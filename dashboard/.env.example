# Copy to .env.local to connect the dashboard to a real Firebase project.
# Leave unset to use the local emulators (project demo-whereismybus).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# true or false; defaults to true for demo- projects.
VITE_USE_EMULATORS=
