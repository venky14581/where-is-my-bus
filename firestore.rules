rules_version = '2';

// Paths not listed here stay closed until the module that needs them opens
// them. Module 1: users. Module 2: routes, buses, routeAccess. Module 3: trips.
// Module 6: alert settings, devices, driver reports, alerts, announcements.
// Module 7: validation of office edits, settings (fares and booking window).
// Module 8: pass secrets and boardings, written only by Cloud Functions.
// Module 9: seat holds on another bus, written only by Cloud Functions.
// Module 10: evening seat bookings, written only by Cloud Functions; a
// student may say they take no college bus every day (dailyRider).
// Module 11: learned arrival times and today's conditions (server-written),
// Not riding today (through a function), a student's walk to their stop.
// Module 12: overspeed and off-route events from the driver's phone, safety
// alerts for the office (server-written, office-acknowledged). Parents'
// trip links (shares) are read only through a function.
// Server-only paths (pushLog, functionRuns, trips/*/approachingSent) stay
// closed to clients.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    // Keep in step with AppConfig.studentEmailDomains in the app.
    function hasCollegeEmail() {
      return signedIn()
        && request.auth.token.email is string
        && tokenEmail().matches('^[a-z0-9._%+-]+@cb[.]students[.]amrita[.]edu$');
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == role;
    }

    function isOffice() {
      return hasRole('office');
    }

    function isDriver() {
      return hasRole('driver');
    }

    // A student profile, a college email and a verified inbox.
    function isVerifiedStudent() {
      return hasRole('student')
        && hasCollegeEmail()
        && request.auth.token.email_verified == true;
    }

    // Routes and buses are for the college only, not the public.
    function canReadBaseData() {
      return isVerifiedStudent() || isDriver() || isOffice();
    }

    function routePath(routeId) {
      return /databases/$(database)/documents/routes/$(routeId);
    }

    // No home stop yet, or a stop that is really on that route.
    function validHomeStop(data) {
      return (data.routeId == null && data.stopId == null)
        || (data.routeId is string
            && exists(routePath(data.routeId))
            && data.stopId in get(routePath(data.routeId)).data.stopIds);
    }

    function busPath(busId) {
      return /databases/$(database)/documents/buses/$(busId);
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    // A driver runs trips only on the bus the office assigned to them.
    function drivesBus(busId) {
      return isDriver()
        && exists(busPath(busId))
        && get(busPath(busId)).data.driverId == request.auth.uid;
    }

    function validName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80;
    }

    function validLanguage(data) {
      return !('language' in data) || data.language == null || data.language in ['en', 'ta'];
    }

    // users/{uid}.alerts: which notifications a student wants. Keep in step
    // with functions/src/audience.ts.
    function validAlertPrefs(data) {
      return !('alerts' in data) || (
        data.alerts is map
        && data.alerts.keys().hasOnly(
             ['approaching', 'leaveHome', 'tripStarted', 'delays', 'announcements', 'leadStops', 'quietDays'])
        && data.alerts.get('approaching', true) is bool
        && data.alerts.get('leaveHome', true) is bool
        && data.alerts.get('tripStarted', true) is bool
        && data.alerts.get('delays', true) is bool
        && data.alerts.get('announcements', true) is bool
        && data.alerts.get('leadStops', 2) in [1, 2, 3]
        && data.alerts.get('quietDays', []) is list
        && data.alerts.get('quietDays', []).size() <= 7
      );
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOffice());

      // Students create their own profile. Drivers and office staff are
      // created by the office, so nobody can give themselves a role or a
      // valid pass.
      allow create: if isOffice() || (
        signedIn()
        && request.auth.uid == uid
        && hasCollegeEmail()
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'role', 'routeId', 'stopId', 'passValid', 'language', 'createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.passValid == false
        && request.resource.data.email == tokenEmail()
        && request.resource.data.routeId == null
        && request.resource.data.stopId == null
        && request.resource.data.createdAt == request.time
        && validName(request.resource.data)
        && validLanguage(request.resource.data)
      );

      allow update: if isOffice() || (
        signedIn()
        && request.auth.uid == uid
        && validLanguage(request.resource.data)
        && (
          (resource.data.role == 'student'
            && onlyChanged(['name', 'language', 'routeId', 'stopId', 'alerts', 'dailyRider', 'walkMinutes'])
            && (!('dailyRider' in request.resource.data) || request.resource.data.dailyRider is bool)
            && (!('walkMinutes' in request.resource.data) || request.resource.data.walkMinutes == null
                || (request.resource.data.walkMinutes is int
                    && request.resource.data.walkMinutes >= 1 && request.resource.data.walkMinutes <= 60))
            && validName(request.resource.data)
            && validHomeStop(request.resource.data)
            && validAlertPrefs(request.resource.data))
          || (resource.data.role == 'driver' && onlyChanged(['language']))
        )
      );

      allow delete: if isOffice();

      // Push tokens, one document per device, named by the token.
      match /devices/{token} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
          && request.resource.data.platform in ['android', 'ios', 'web']
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Only the office edits base data, and only in a shape the apps can use.
    // The import script and the dashboard keep stopIds in step with stops.
    function validRoute(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.city is string && data.city.size() > 0
        && data.stops is list && data.stops.size() >= 2 && data.stops.size() <= 60
        && data.stopIds is list && data.stopIds.size() == data.stops.size()
        && (!('guestFare' in data) || data.guestFare == null
            || (data.guestFare is number && data.guestFare >= 0 && data.guestFare <= 1000));
    }

    function validBus(data) {
      return data.number is string && data.number.size() > 0 && data.number.size() <= 20
        && data.capacity is int && data.capacity >= 1 && data.capacity <= 120
        && (data.routeId == null || exists(routePath(data.routeId)))
        && (data.driverId == null || data.driverId is string);
    }

    match /routes/{routeId} {
      allow read: if canReadBaseData();
      allow create, update: if isOffice() && validRoute(request.resource.data);
      allow delete: if isOffice();
    }

    match /buses/{busId} {
      allow read: if canReadBaseData();
      allow create, update: if isOffice() && validBus(request.resource.data);
      allow delete: if isOffice();
    }

    // settings/booking: when guest booking opens and closes (Module 10).
    match /settings/{name} {
      allow read: if canReadBaseData();
      allow write: if isOffice();
    }

    match /routeAccess/{routeId} {
      allow read: if canReadBaseData();
      allow write: if isOffice();
    }

    // One trip per bus, day and direction: {date}_{busId}_{direction}.
    match /trips/{tripId} {
      allow read: if canReadBaseData();

      allow create: if drivesBus(request.resource.data.busId)
        && request.resource.data.keys().hasOnly(
             ['busId', 'routeId', 'driverId', 'date', 'direction', 'status', 'startedAt', 'endedAt'])
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.routeId == get(busPath(request.resource.data.busId)).data.routeId
        && request.resource.data.direction in ['toCampus', 'fromCampus']
        && request.resource.data.date is string
        && tripId == request.resource.data.date + '_' + request.resource.data.busId + '_' + request.resource.data.direction
        && request.resource.data.status == 'running'
        && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null;

      // End the trip, or resume it after the app restarts.
      allow update: if resource.data.driverId == request.auth.uid
        && drivesBus(resource.data.busId)
        && onlyChanged(['status', 'endedAt'])
        && ((request.resource.data.status == 'running' && request.resource.data.endedAt == null)
            || (request.resource.data.status == 'ended' && request.resource.data.endedAt == request.time));

      // Actual time at each stop. Recorded by the phone; history for arrival
      // times (Module 5), punctuality reports and the learned model (Module 11).
      match /stopTimes/{stopId} {
        allow read: if canReadBaseData();
        allow create, update: if signedIn()
          && exists(tripPath(tripId))
          && get(tripPath(tripId)).data.driverId == request.auth.uid
          && get(tripPath(tripId)).data.status == 'running'
          && request.resource.data.keys().hasOnly(['stopId', 'arrivedAt', 'recordedAt'])
          && request.resource.data.stopId == stopId
          && stopId in get(routePath(get(tripPath(tripId)).data.routeId)).data.stopIds
          && request.resource.data.arrivedAt is timestamp
          && request.resource.data.recordedAt == request.time;
      }

      // Who boarded, written by the scanPass function. The trip's driver
      // sees them for a head count; the office for reports.
      match /boardings/{uid} {
        allow read: if isOffice() || (signedIn() && get(tripPath(tripId)).data.driverId == request.auth.uid);
      }

      // Pass holders not taking this evening bus, set by setNotRiding.
      match /notRiding/{uid} {
        allow read: if isOffice() || (signedIn() && request.auth.uid == uid);
      }

      // Overspeeding or leaving the route, noticed by the driver's phone, one
      // per episode. onSafetyEvent turns each into an office alert.
      match /events/{eventId} {
        allow read: if isOffice() || (signedIn() && get(tripPath(tripId)).data.driverId == request.auth.uid);
        allow create: if signedIn()
          && exists(tripPath(tripId))
          && get(tripPath(tripId)).data.driverId == request.auth.uid
          && get(tripPath(tripId)).data.status == 'running'
          && request.resource.data.keys().hasOnly(['type', 'lat', 'lng', 'speedKmh', 'limitKmh', 'distanceM', 'createdAt'])
          && request.resource.data.type in ['overspeed', 'offRoute']
          && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
          && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
          && request.resource.data.get('speedKmh', 0) is number && request.resource.data.get('speedKmh', 0) < 250
          && request.resource.data.get('limitKmh', 0) is number
          && request.resource.data.get('distanceM', 0) is number
          && request.resource.data.createdAt == request.time;
      }

      // Seats held by riders from other routes (missed-bus help), written
      // by the holdSeat function. The student sees their own; the trip's
      // driver sees who to expect where.
      match /holds/{uid} {
        allow read: if isOffice()
          || (signedIn() && request.auth.uid == uid)
          || (signedIn() && get(tripPath(tripId)).data.driverId == request.auth.uid);
      }

      // Running late and Breakdown, from the trip's driver while it runs.
      match /reports/{reportId} {
        allow read: if canReadBaseData();
        allow create: if signedIn()
          && exists(tripPath(tripId))
          && get(tripPath(tripId)).data.driverId == request.auth.uid
          && get(tripPath(tripId)).data.status == 'running'
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type in ['late', 'breakdown']
          && request.resource.data.createdAt == request.time;
      }
    }

    // The secret behind a student's rotating pass QR. Only that student's
    // phone and the server may know it; never written by a client.
    match /passSecrets/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Evening seat bookings, one per student per trip. Made, paid and used
    // only through Cloud Functions; the ticket token is the student's own.
    match /bookings/{bookingId} {
      allow read: if isOffice() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // Learned travel times between stops and the usual delay, from
    // ml/train.py; and how today's buses compare with them. Server-written.
    match /segmentTimes/{routeId} {
      allow read: if canReadBaseData();
    }

    match /conditions/{date} {
      allow read: if canReadBaseData();
    }

    // SOS, overspeed and off-route alerts for the transport office. Written
    // by Cloud Functions; the office marks them acknowledged.
    match /safetyAlerts/{alertId} {
      allow read: if isOffice();
      allow update: if isOffice()
        && onlyChanged(['status', 'acknowledgedBy', 'acknowledgedAt'])
        && request.resource.data.status == 'acknowledged'
        && request.resource.data.acknowledgedBy == request.auth.uid
        && request.resource.data.acknowledgedAt == request.time;
    }

    // The in-app alerts list. Written only by Cloud Functions.
    match /alerts/{alertId} {
      allow read: if canReadBaseData();
    }

    // Public buses and trains a student can take instead of a college bus
    // (missed-bus help). Fixed timings entered by the office, not live.
    function validTimetable(d) {
      return d.keys().hasOnly(['routeId', 'mode', 'name', 'from', 'to', 'departs', 'direction', 'note', 'fare'])
        && d.routeId is string && exists(routePath(d.routeId))
        && d.mode in ['bus', 'train']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.from is string && d.from.size() > 0 && d.from.size() <= 60
        && d.to is string && d.to.size() > 0 && d.to.size() <= 60
        && d.departs is string && d.departs.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && d.direction in ['toCampus', 'fromCampus']
        && (!('note' in d) || d.note == null || (d.note is string && d.note.size() <= 140))
        && (!('fare' in d) || d.fare == null || (d.fare is number && d.fare >= 0 && d.fare <= 1000));
    }

    match /timetable/{id} {
      allow read: if canReadBaseData();
      allow create, update: if isOffice() && validTimetable(request.resource.data);
      allow delete: if isOffice();
    }

    // To one route (routeId) or to everyone (routeId null).
    match /announcements/{id} {
      allow read: if canReadBaseData();
      allow create: if isOffice()
        && request.resource.data.keys().hasOnly(['routeId', 'title', 'body', 'createdAt', 'createdBy'])
        && (request.resource.data.routeId == null || exists(routePath(request.resource.data.routeId)))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isOffice();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
