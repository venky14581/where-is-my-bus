rules_version = '2';

// Paths not listed here stay closed until the module that needs them opens
// them. Module 1: users. Module 2: routes, buses, routeAccess. Module 3: trips.
// Module 6: alert settings, devices, driver reports, alerts, announcements.
// Server-only paths (pushLog, trips/*/approachingSent) stay closed to clients.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    // Keep in step with AppConfig.studentEmailDomains in the app.
    function hasCollegeEmail() {
      return signedIn()
        && request.auth.token.email is string
        && tokenEmail().matches('^[a-z0-9._%+-]+@cb[.]students[.]amrita[.]edu$');
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == role;
    }

    function isOffice() {
      return hasRole('office');
    }

    function isDriver() {
      return hasRole('driver');
    }

    // A student profile, a college email and a verified inbox.
    function isVerifiedStudent() {
      return hasRole('student')
        && hasCollegeEmail()
        && request.auth.token.email_verified == true;
    }

    // Routes and buses are for the college only, not the public.
    function canReadBaseData() {
      return isVerifiedStudent() || isDriver() || isOffice();
    }

    function routePath(routeId) {
      return /databases/$(database)/documents/routes/$(routeId);
    }

    // No home stop yet, or a stop that is really on that route.
    function validHomeStop(data) {
      return (data.routeId == null && data.stopId == null)
        || (data.routeId is string
            && exists(routePath(data.routeId))
            && data.stopId in get(routePath(data.routeId)).data.stopIds);
    }

    function busPath(busId) {
      return /databases/$(database)/documents/buses/$(busId);
    }

    function tripPath(tripId) {
      return /databases/$(database)/documents/trips/$(tripId);
    }

    // A driver runs trips only on the bus the office assigned to them.
    function drivesBus(busId) {
      return isDriver()
        && exists(busPath(busId))
        && get(busPath(busId)).data.driverId == request.auth.uid;
    }

    function validName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80;
    }

    function validLanguage(data) {
      return !('language' in data) || data.language == null || data.language in ['en', 'ta'];
    }

    // users/{uid}.alerts: which notifications a student wants. Keep in step
    // with functions/src/audience.ts.
    function validAlertPrefs(data) {
      return !('alerts' in data) || (
        data.alerts is map
        && data.alerts.keys().hasOnly(
             ['approaching', 'tripStarted', 'delays', 'announcements', 'leadStops', 'quietDays'])
        && data.alerts.get('approaching', true) is bool
        && data.alerts.get('tripStarted', true) is bool
        && data.alerts.get('delays', true) is bool
        && data.alerts.get('announcements', true) is bool
        && data.alerts.get('leadStops', 2) in [1, 2, 3]
        && data.alerts.get('quietDays', []) is list
        && data.alerts.get('quietDays', []).size() <= 7
      );
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOffice());

      // Students create their own profile. Drivers and office staff are
      // created by the office, so nobody can give themselves a role or a
      // valid pass.
      allow create: if isOffice() || (
        signedIn()
        && request.auth.uid == uid
        && hasCollegeEmail()
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'role', 'routeId', 'stopId', 'passValid', 'language', 'createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.passValid == false
        && request.resource.data.email == tokenEmail()
        && request.resource.data.routeId == null
        && request.resource.data.stopId == null
        && request.resource.data.createdAt == request.time
        && validName(request.resource.data)
        && validLanguage(request.resource.data)
      );

      allow update: if isOffice() || (
        signedIn()
        && request.auth.uid == uid
        && validLanguage(request.resource.data)
        && (
          (resource.data.role == 'student'
            && onlyChanged(['name', 'language', 'routeId', 'stopId', 'alerts'])
            && validName(request.resource.data)
            && validHomeStop(request.resource.data)
            && validAlertPrefs(request.resource.data))
          || (resource.data.role == 'driver' && onlyChanged(['language']))
        )
      );

      allow delete: if isOffice();

      // Push tokens, one document per device, named by the token.
      match /devices/{token} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['platform', 'updatedAt'])
          && request.resource.data.platform in ['android', 'ios', 'web']
          && request.resource.data.updatedAt == request.time;
      }
    }

    // Only the office edits base data. The import script and the dashboard
    // keep stopIds in step with stops.
    match /routes/{routeId} {
      allow read: if canReadBaseData();
      allow write: if isOffice();
    }

    match /buses/{busId} {
      allow read: if canReadBaseData();
      allow write: if isOffice();
    }

    match /routeAccess/{routeId} {
      allow read: if canReadBaseData();
      allow write: if isOffice();
    }

    // One trip per bus, day and direction: {date}_{busId}_{direction}.
    match /trips/{tripId} {
      allow read: if canReadBaseData();

      allow create: if drivesBus(request.resource.data.busId)
        && request.resource.data.keys().hasOnly(
             ['busId', 'routeId', 'driverId', 'date', 'direction', 'status', 'startedAt', 'endedAt'])
        && request.resource.data.driverId == request.auth.uid
        && request.resource.data.routeId == get(busPath(request.resource.data.busId)).data.routeId
        && request.resource.data.direction in ['toCampus', 'fromCampus']
        && request.resource.data.date is string
        && tripId == request.resource.data.date + '_' + request.resource.data.busId + '_' + request.resource.data.direction
        && request.resource.data.status == 'running'
        && request.resource.data.startedAt == request.time
        && request.resource.data.endedAt == null;

      // End the trip, or resume it after the app restarts.
      allow update: if resource.data.driverId == request.auth.uid
        && drivesBus(resource.data.busId)
        && onlyChanged(['status', 'endedAt'])
        && ((request.resource.data.status == 'running' && request.resource.data.endedAt == null)
            || (request.resource.data.status == 'ended' && request.resource.data.endedAt == request.time));

      // Actual time at each stop. Recorded by the phone; history for arrival
      // times (Module 5), punctuality reports and the learned model (Module 11).
      match /stopTimes/{stopId} {
        allow read: if canReadBaseData();
        allow create, update: if signedIn()
          && exists(tripPath(tripId))
          && get(tripPath(tripId)).data.driverId == request.auth.uid
          && get(tripPath(tripId)).data.status == 'running'
          && request.resource.data.keys().hasOnly(['stopId', 'arrivedAt', 'recordedAt'])
          && request.resource.data.stopId == stopId
          && stopId in get(routePath(get(tripPath(tripId)).data.routeId)).data.stopIds
          && request.resource.data.arrivedAt is timestamp
          && request.resource.data.recordedAt == request.time;
      }

      // Running late and Breakdown, from the trip's driver while it runs.
      match /reports/{reportId} {
        allow read: if canReadBaseData();
        allow create: if signedIn()
          && exists(tripPath(tripId))
          && get(tripPath(tripId)).data.driverId == request.auth.uid
          && get(tripPath(tripId)).data.status == 'running'
          && request.resource.data.keys().hasOnly(['type', 'createdAt'])
          && request.resource.data.type in ['late', 'breakdown']
          && request.resource.data.createdAt == request.time;
      }
    }

    // The in-app alerts list. Written only by Cloud Functions.
    match /alerts/{alertId} {
      allow read: if canReadBaseData();
    }

    // To one route (routeId) or to everyone (routeId null).
    match /announcements/{id} {
      allow read: if canReadBaseData();
      allow create: if isOffice()
        && request.resource.data.keys().hasOnly(['routeId', 'title', 'body', 'createdAt', 'createdBy'])
        && (request.resource.data.routeId == null || exists(routePath(request.resource.data.routeId)))
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 500
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isOffice();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
