rules_version = '2';

// Module 1: accounts only. Every other collection stays closed until the
// module that needs it opens it.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    // Keep in step with AppConfig.studentEmailDomains in the app.
    function hasCollegeEmail() {
      return signedIn()
        && request.auth.token.email is string
        && tokenEmail().matches('^[a-z0-9._%+-]+@cb[.]students[.]amrita[.]edu$');
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && profile().role == role;
    }

    function isOffice() {
      return hasRole('office');
    }

    // What later modules use to let students read routes and live buses:
    // a student profile, a college email and a verified inbox.
    function isVerifiedStudent() {
      return hasRole('student')
        && hasCollegeEmail()
        && request.auth.token.email_verified == true;
    }

    function validName(data) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 80;
    }

    function validLanguage(data) {
      return !('language' in data) || data.language == null || data.language in ['en', 'ta'];
    }

    function onlyChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isOffice());

      // Students create their own profile. Drivers and office staff are
      // created by the office, so nobody can give themselves a role or a
      // valid pass.
      allow create: if isOffice() || (
        signedIn()
        && request.auth.uid == uid
        && hasCollegeEmail()
        && request.resource.data.keys().hasOnly(
             ['name', 'email', 'role', 'routeId', 'stopId', 'passValid', 'language', 'createdAt'])
        && request.resource.data.role == 'student'
        && request.resource.data.passValid == false
        && request.resource.data.email == tokenEmail()
        && request.resource.data.routeId == null
        && request.resource.data.stopId == null
        && request.resource.data.createdAt == request.time
        && validName(request.resource.data)
        && validLanguage(request.resource.data)
      );

      allow update: if isOffice() || (
        signedIn()
        && request.auth.uid == uid
        && validLanguage(request.resource.data)
        && (
          // Module 2 checks routeId and stopId against real routes.
          (resource.data.role == 'student'
            && onlyChanged(['name', 'language', 'routeId', 'stopId'])
            && validName(request.resource.data))
          || (resource.data.role == 'driver' && onlyChanged(['language']))
        )
      );

      allow delete: if isOffice();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
