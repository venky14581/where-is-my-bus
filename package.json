{
  "name": "where-is-my-bus",
  "private": true,
  "type": "module",
  "description": "Firebase emulator tooling, seed data and security-rules tests for Where Is My Bus",
  "scripts": {
    "emulators": "node scripts/emulators.mjs",
    "seed": "node scripts/seed-emulators.mjs",
    "build-paths": "node scripts/build-route-paths.mjs",
    "simulate-bus": "node scripts/simulate-bus.mjs",
    "announce": "node scripts/announce.mjs",
    "test:functions": "npm --prefix functions test",
    "test:e2e": "node scripts/e2e.mjs",
    "test:rules": "firebase emulators:exec --project demo-whereismybus --only firestore,database \"vitest run tests/rules\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-admin": "^13.0.0",
    "vitest": "^3.2.0"
  }
}
