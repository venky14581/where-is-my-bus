{
  "rules": {
    ".read": false,
    ".write": false,

    // busId -> uid of the assigned driver. Mirrors buses/{busId}.driverId in
    // Firestore, because these rules cannot read Firestore. Keep both in step.
    "busDrivers": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('officeUids').child(auth.uid).exists()",
      "$busId": {
        ".validate": "newData.isString()"
      }
    },

    // Written only by the admin import script.
    "officeUids": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },

    // Latest position of each bus, nothing older. Only college accounts may
    // see it: verified students, drivers and the office.
    "live": {
      ".read": "auth != null && ((auth.token.email_verified === true && auth.token.email.toLowerCase().matches(/^[a-z0-9._%+-]+@cb\\.students\\.amrita\\.edu$/)) || auth.token.email.toLowerCase().matches(/@drivers\\.whereismybus\\.invalid$/) || root.child('officeUids').child(auth.uid).exists())",
      "$busId": {
        ".write": "auth != null && root.child('busDrivers').child($busId).val() === auth.uid",
        ".validate": "newData.hasChildren(['lat', 'lng', 'updatedAt', 'tripId', 'status'])",
        "lat": { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng": { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "speed": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() < 70" },
        "heading": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 360" },
        "accuracy": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "tripId": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "status": { ".validate": "newData.val() === 'running' || newData.val() === 'offline' || newData.val() === 'ended'" },
        "$other": { ".validate": false }
      }
    }
  }
}
